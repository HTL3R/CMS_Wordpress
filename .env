# Shared development defaults. This file IS committed, exactly like the other
# WEBT projects: none of it is secret and every student needs the same values.
# Anything genuinely secret belongs in .env.local, which git ignores.
# Compose reads this file automatically; the shell wins over it, so a one-off
# override is just: HTTP_PORT=9000 ./start.sh

# Host port for the site. http://localhost:8080
HTTP_PORT=8080

# Database credentials. Development values -- the database is not published to
# the host, so it is only reachable from the wordpress container.
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=root

# 1 = show PHP notices and warnings in the page while developing.
WORDPRESS_DEBUG=1
