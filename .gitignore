# Local secrets / overrides
.env.local

# Runtime content generated by WordPress.
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/debug.log

# Themes and plugins that ship INSIDE the wordpress image. They reappear by
# themselves in a fresh checkout as soon as the container starts, so tracking
# them would add thousands of files that nobody edits.
wp-content/index.php
wp-content/themes/index.php
wp-content/themes/twenty*/
wp-content/plugins/index.php
wp-content/plugins/hello.php
wp-content/plugins/akismet/

# Everything you write yourself under wp-content/themes/ and
# wp-content/plugins/ IS tracked -- that is the point of the project.

# Exported Docker images
/_images/

# Editors / OS
.idea
.DS_Store
*.swp
